# Production application URL, for example https://example.com
APP_URL=

# Hostinger production MySQL connection settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Long, random session signing secret
SESSION_SECRET=

# Absolute persistent image directory outside build/. Set on the host only.
UPLOAD_ROOT=
# Public path served safely by this Node application, or its full HTTPS URL.
MEDIA_BASE_URL=/uploads

# Optional HTTP port provided by the host (defaults to 3000)
PORT=3000
